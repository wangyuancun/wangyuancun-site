---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, GITHUB, WECHAT, EMAIL } from '../consts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'zh' | 'en';
  image?: string;
  type?: 'website' | 'article' | 'profile';
  schema?: Record<string, any> | Record<string, any>[];
  altZh?: string;
  altEn?: string;
  narrow?: boolean;
  active?: 'home' | 'blog' | 'products' | 'about';
  publishedTime?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title,
  description,
  lang = 'zh',
  image,
  type,
  schema,
  altZh,
  altEn,
  narrow = false,
  active,
  publishedTime,
  tags,
  noindex,
} = Astro.props;

const isEn = lang === 'en';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={isEn ? 'en' : 'zh-CN'}>
  <head>
    <BaseHead
      title={title}
      description={description}
      lang={lang}
      type={type}
      image={image}
      altZh={altZh}
      altEn={altEn}
      publishedTime={publishedTime}
      tags={tags}
      noindex={noindex}
      schema={schema}
    />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) {
            t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.dataset.theme = t;
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{isEn ? 'Skip to content' : '跳到正文'}</a>

    <header class="site">
      <a class="brand" href={isEn ? '/en/' : '/'}>{SITE_TITLE}</a>
      <nav aria-label={isEn ? 'Primary' : '主导航'}>
        {
          isEn ? (
            <>
              <a href="/">中文</a>
              <a href="/blog/" class={active === 'blog' ? 'on' : ''}>Writing</a>
              <a href="/products/" class={active === 'products' ? 'on' : ''}>Projects</a>
            </>
          ) : (
            <>
              <a href="/blog/" class={active === 'blog' ? 'on' : ''}>文章</a>
              <a href="/products/" class={active === 'products' ? 'on' : ''}>作品</a>
              <a href="/about/" class={active === 'about' ? 'on' : ''}>关于</a>
              <a href="/en/" class="lang" title="English">EN</a>
            </>
          )
        }
        <button class="theme" id="theme-toggle" type="button" aria-label={isEn ? 'Toggle theme' : '切换深浅色'}>
          <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
          </svg>
          <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
        </button>
      </nav>
    </header>

    <main id="main" class={narrow ? 'narrow' : ''}>
      <slot />
    </main>

    <footer class="site">
      <span>© {year} {SITE_TITLE}{isEn ? '' : ' · 上海'}</span>
      <span class="links">
        <a href={GITHUB}>GitHub</a>
        <a href="/rss.xml">RSS</a>
        <a href={`mailto:${EMAIL}`}>Email</a>
        {!isEn && <span>公众号：{WECHAT}</span>}
      </span>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', function () {
        var root = document.documentElement;
        var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
      });
    </script>
  </body>
</html>
