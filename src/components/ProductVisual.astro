---
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const d = product.data;
const shot = d.shots.length > 0 ? d.shots[0] : undefined;
---

{
  shot ? (
    <img src={shot.src} alt={shot.alt} width="540" height="960" loading="lazy" decoding="async" />
  ) : d.terminal.length > 0 ? (
    <div class="visual term">
      {d.terminalTitle && <div class="vtitle">{d.terminalTitle}</div>}
      {d.terminal.map((line) => (
        <div class:list={['ln', { ok: line.startsWith('✓'), cmd: line.startsWith('$') }]}>
          {line}
        </div>
      ))}
    </div>
  ) : d.tree.length > 0 ? (
    <div class="visual tree">
      {d.tree.map((line) => (
        <div class="ln">{line}</div>
      ))}
    </div>
  ) : (
    <div class="tile">
      <span class="zi">{d.name.slice(0, 1)}</span>
      <span class="sub">{d.meta.split('·')[0].trim()}</span>
    </div>
  )
}
