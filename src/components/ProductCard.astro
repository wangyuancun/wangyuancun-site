---
import type { CollectionEntry } from 'astro:content';
import ProductVisual from './ProductVisual.astro';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const d = product.data;
---

<a class="card product" href={`/products/${product.id}/`}>
  <div class="thumb">
    <ProductVisual product={product} />
  </div>
  <div class="card-body">
    <h3>
      {d.name}
      {d.status && (
        <span class:list={['status', { muted: d.status === '开源' || d.status === '已发布' }]}>
          {d.status}
        </span>
      )}
    </h3>
    <p>{d.summary}</p>
  </div>
</a>
