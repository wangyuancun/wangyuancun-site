---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WECHAT } from '../../consts';
import { getPublishedPosts } from '../../lib/blog';

export async function getStaticPaths() {
  // 只给已到发布时间的文章生成页面，没到点的直接 404
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title={post.data.title} description={post.data.summary}>
  <h1>{post.data.title}</h1>
  <div class="meta">
    {post.data.tags.map((tag) => (
      <span class="tag">{tag}</span>
    ))}
    {fmt(post.data.date)}
  </div>

  <Content />

  {post.data.wechatUrl && (
    <p style="margin-top:48px;font-size:14px;color:var(--fg-muted)">
      本文首发于公众号「{WECHAT}」 · <a
        href={post.data.wechatUrl}
        target="_blank"
        rel="noopener noreferrer">查看原文</a>
    </p>
  )}
</BaseLayout>
