---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getSortedPosts } from '../../lib/blog';

const posts = await getSortedPosts();
---

<BaseLayout
  title="全部文章"
  description="按时间倒序排列的技术与生活笔记。"
  active="blog"
>
  <h1>全部文章</h1>
  <p class="lead">技术为主，生活为辅。目前 {posts.length} 篇。</p>

  {
    posts.length === 0 ? (
      <p>还没有文章。新文章发布后会按时间从新到旧排在这里。</p>
    ) : (
      <div class="grid">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )
  }
</BaseLayout>
