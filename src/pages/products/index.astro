---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const products = (await getCollection('products')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="产品与作品"
  description="自己做的东西：HarmonyOS 应用、WorkBuddy 技能、开源模板。"
>
  <h1>产品与作品</h1>
  <p class="intro">
    自己做的、还在维护的东西。有 GitHub 的直接可点；还没上架的，就写明现在到哪一步。
  </p>

  <ul class="post-list">
    {products.map((product) => (
      <li>
        <div class="head">
          <a class="title" href={`/products/${product.id}/`}>{product.data.name}</a>
          {product.data.status && <span class="status">{product.data.status}</span>}
        </div>
        <div class="desc">{product.data.summary}</div>
        <div class="links">
          {product.data.links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
          {product.data.links.length > 0 && <span class="sep">·</span>}
          <a href={`/products/${product.id}/`}>详情 →</a>
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .intro {
    color: var(--fg-muted);
    margin: 0 0 8px;
  }

  .head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .status {
    font-size: 12px;
    line-height: 1.6;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 3px;
    padding: 0 6px;
  }

  .desc {
    font-size: 14px;
    color: var(--fg-muted);
    margin-top: 2px;
  }

  .links {
    font-size: 14px;
    margin-top: 6px;
  }

  .links .sep {
    color: var(--line);
    margin: 0 8px;
  }
</style>
